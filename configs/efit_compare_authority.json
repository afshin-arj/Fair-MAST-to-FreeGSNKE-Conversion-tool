{
  "authority_name": "efit_compare",
  "authority_version": "1.2",
  "source": "fairmast_level2_equilibrium",
  "label": "FAIR-MAST EFIT++ archive (not efit-ai Fortran)",
  "tokamark_reference": "https://github.com/UKAEA-IBM-STFC-Fusion-FMs/tokamark",
  "fairmast_docs": "https://mastapp.site/level2-data.html",
  "validation_reference": "https://arxiv.org/html/2407.12432v4",
  "compare_mode": "both",
  "enable_forward_replay": true,
  "require_forward_replay": false,
  "current_source": "measured_pf_at_compare_time",
  "psi_convention": "Wb_per_2pi",
  "equilibrium_group": "equilibrium",
  "output_relpath": "04_efit_compare",
  "fail_closed_if_missing": false,
  "shape_scalars": [
    "elongation",
    "elongation_axis",
    "triangularity_upper",
    "triangularity_lower",
    "minor_radius",
    "magnetic_axis_r",
    "magnetic_axis_z",
    "x_point_r",
    "x_point_z",
    "q95",
    "beta_tor",
    "beta_pol",
    "beta_normal",
    "li",
    "wmhd"
  ],
  "lcfs_vars": ["lcfs_r", "lcfs_z"],
  "psi_var": "psi",
  "time_policy": "nearest_to_window_midpoint",
  "write_side_by_side_gif": true,
  "side_by_side_n_frames": 24,
  "side_by_side_fps": 2.0,
  "notes": "ADR-002/v1.2. Primary scorecard prefers forward_replay when ADR-004 profile_trajectory is ok: measured PF (pf_active/coil_map) + EFIT-fitted ConstrainPaxisIp → FreeGSNKE forward GS, scored vs archived EFIT++ shapes. Falls back to reconstruction_vs_archive if forward_replay soft-skips. Not a live EFIT++ / efit-ai solve."
}
